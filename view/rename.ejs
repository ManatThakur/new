<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/styles/output.css">
  <style>
    #firstpage {
      background-image: url('https://images.unsplash.com/photo-1557821552-17105176677c?w=1200&h=600&fit=crop');
      background-size: fill;
      background-position: center;
      
    }
  </style>
</head>
<body>
 
<header class="shadow-md tracking-wide relative z-50">
      <section class="py-2 bg-[#007bff] text-white text-right px-10">
        <p class="text-sm"><span class="mx-3 font-semibold">Address:</span>SWF New York 185669<span class="mx-3 font-semibold">Contact
          No:</span>1800333665</p>
      </section>

      <div class="flex flex-wrap items-center justify-between gap-4 px-10 py-3 bg-white min-h-[65px]">
        <a href="javascript:void(0)"><img src="https://readymadeui.com/readymadeui.svg" alt="logo" class="w-36" />
        </a>

        <div id="collapseMenu"
          class="max-lg:hidden lg:!block max-lg:before:fixed max-lg:before:bg-black max-lg:before:opacity-50 max-lg:before:inset-0 max-lg:before:z-50">
          <button id="toggleClose" class="lg:hidden fixed top-2 right-4 z-[100] rounded-full bg-white w-9 h-9 flex items-center justify-center border border-gray-200 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-black" viewBox="0 0 320.591 320.591">
              <path
                d="M30.391 318.583a30.37 30.37 0 0 1-21.56-7.288c-11.774-11.844-11.774-30.973 0-42.817L266.643 10.665c12.246-11.459 31.462-10.822 42.921 1.424 10.362 11.074 10.966 28.095 1.414 39.875L51.647 311.295a30.366 30.366 0 0 1-21.256 7.288z"
                data-original="#000000"></path>
              <path
                d="M287.9 318.583a30.37 30.37 0 0 1-21.257-8.806L8.83 51.963C-2.078 39.225-.595 20.055 12.143 9.146c11.369-9.736 28.136-9.736 39.504 0l259.331 257.813c12.243 11.462 12.876 30.679 1.414 42.922-.456.487-.927.958-1.414 1.414a30.368 30.368 0 0 1-23.078 7.288z"
                data-original="#000000"></path>
            </svg>
          </button>

          <ul
            class="lg:flex lg:gap-x-5 max-lg:space-y-3 max-lg:fixed max-lg:bg-white max-lg:w-1/2 max-lg:min-w-[300px] max-lg:top-0 max-lg:left-0 max-lg:p-6 max-lg:h-full max-lg:shadow-md max-lg:overflow-auto z-50">
            <li class="mb-6 hidden max-lg:block">
              <a href="javascript:void(0)"><img src="https://readymadeui.com/readymadeui.svg" alt="logo" class="w-36" />
              </a>
            </li>
            <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3 px-3">
              <a href='javascript:void(0)'
                class="hover:text-blue-700 text-blue-700 block font-medium text-[15px]">Home</a>
            </li>
            <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3 px-3"><a href='javascript:void(0)'
              class="hover:text-blue-700 text-slate-900 block font-medium text-[15px]">Team</a>
            </li>
            <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3 px-3"><a href='/form' onclick="window.location.href='/form'; return false;"
              class="hover:text-blue-700 text-slate-900 block font-medium text-[15px]">Sell</a>
            </li>
            <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3 px-3"><a href='/buy' onclick="window.location.href='/buy'; return false;"
              class="hover:text-blue-700 text-slate-900 block font-medium text-[15px]">Buy</a>
            </li>
            <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3 px-3"><a href='javascript:void(0)'
              class="hover:text-blue-700 text-slate-900 block font-medium text-[15px]">About</a>
            </li>
            <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3 px-3"><a href='javascript:void(0)'
              class="hover:text-blue-700 text-slate-900 block font-medium text-[15px]">Contact</a>
            </li>
            <li class="max-lg:border-b max-lg:border-gray-300 max-lg:py-3 px-3"><a href='javascript:void(0)'
              class="hover:text-blue-700 text-slate-900 block font-medium text-[15px]">Source</a>
            </li>
          </ul>
        </div>

        <div class="flex max-lg:ml-auto">
          <button id="toggleOpen" class="lg:hidden cursor-pointer">
            <svg class="w-7 h-7" fill="#000" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd"
                d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                clip-rule="evenodd"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
  <div id="firstpage">
    <div class="px-4 pt-6 pb-4">
    <h1 class="text-2xl font-bold">Find your stay</h1>
    <p class="text-gray-500 text-sm">Homes • Apartments • Villas</p>
    <button onclick="window.location.href='/form'; return false;" class="mt-4 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg font-medium">Add Property</button>
  </div>

  <!-- Search Bar -->
  <div class="px-4 mb-5">
    <div class="bg-white rounded-xl shadow flex items-center px-4 py-3">
      <span class="text-gray-400 mr-2">🔍</span>
      <input
        type="text"
        placeholder="Where are you going?"
        class="w-full outline-none text-sm"
      />
    </div>
  </div>
<% if (homes.length === 0) { %>
  <h2 class="text-center text-xl font-semibold mt-6 text-gray-600">
    No homes added yet
  </h2>
<% } else { %>

  <div class="px-2 mt-3 flex flex-col gap-3">
    
    <% homes.forEach(home => { %>

      <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition duration-300 hover:-translate-y-2">

        <!-- Optional Image -->
       

        <div class="p-5">
          
         <img src="<%= home.image %>" alt="Home Image" class="w-full h-100 mb-2 rounded-lg">
          <h2 class="text-lg font-semibold text-gray-800">
            <%= home.homeName %>
          </h2>

          <p class="text-sm text-gray-500 mt-2">
            📍 <%= home.address %>
          </p>

          <p class="text-sm text-gray-500">
            🛏 Rooms: <%= home.rooms %>
          </p>
        
          <div class="flex justify-between items-center mt-4">
            <span class="text-xl font-bold text-blue-600">
              ₹<%= home.price %>
              <span class="text-sm font-normal text-gray-500">/night</span>
            </span>

          
          </div>
        </div>

      </div>

    <% }) %>

  </div>

<% } %>
  <!-- Categories -->
  <div class="px-4 mb-6 flex gap-3 overflow-x-auto">
    <div class="bg-black text-white px-4 py-2 rounded-full text-sm whitespace-nowrap">
      Popular
    </div>
    <div class="bg-white px-4 py-2 rounded-full text-sm shadow whitespace-nowrap">
      Beach
    </div>
    <div class="bg-white px-4 py-2 rounded-full text-sm shadow whitespace-nowrap">
      Mountains
    </div>
    <div class="bg-white px-4 py-2 rounded-full text-sm shadow whitespace-nowrap">
      City
    </div>
  </div>

  <!-- Listings -->
  <div class="px-4 grid grid-cols-1 gap-5">

    <!-- Card -->
    <div class="bg-white rounded-2xl shadow overflow-hidden active:scale-95 transition">
      <img
        src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/618739759.jpg?k=b64be5ba437ed9c3169791b68de86a5b346cd6df09a046e331b2dffbafde9ba4&o="
        alt="Home"
        class="w-full h-75 object-cover"
      />
      <div class="p-4">
        <h3 class="font-semibold text-lg">Cozy Beach House</h3>
        <p class="text-sm text-gray-500">Goa • 2 guests • 1 bed</p>
        <div class="flex justify-between items-center mt-3">
          <span class="font-bold text-lg">₹3,500<span class="text-sm font-normal">/night</span></span>
          <span class="text-yellow-500 text-sm">⭐ 4.8</span>
        </div>
      </div>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl shadow overflow-hidden active:scale-95 transition">
      <img
        src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1d/1a/7a/f5/aussenansicht-mit-sonnenterras.jpg?w=900&h=500&s=1"
        alt="Home"
        class="w-full h-80"
      />
      <div class="p-4">
        <h3 class="font-semibold text-lg">Mountain View Cabin</h3>
        <p class="text-sm text-gray-500">Manali • 4 guests • 2 beds</p>
        <div class="flex justify-between items-center mt-3">
          <span class="font-bold text-lg">₹4,200<span class="text-sm font-normal">/night</span></span>
          <span class="text-yellow-500 text-sm">⭐ 4.9</span>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom CTA -->
  <div class="fixed bottom-0 left-0 right-0 bg-white p-4 shadow">
    <button onclick="location.href='/buy'" class="w-full bg-black text-white py-3 rounded-xl font-semibold">
      Explore more
    </button>
  </div>
  </div>
</body>
</html>