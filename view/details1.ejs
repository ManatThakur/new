

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= home.homeName %></title>
  <link rel="stylesheet" href="/styles/output.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen">

  <!-- Container -->
  <div class="max-w-7xl mx-auto p-6">

    <!-- Back Button -->
    <a href="/" 
       class="inline-block mb-6 text-blue-600 hover:text-blue-800 font-medium">
      ← Back to Listings
    </a>

    <!-- Main Card -->
    <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

      <!-- Hero Image -->
      <div class="relative h-[400px] overflow-hidden">
        <img src="<%= home.image %>" 
             class="w-full h-full object-cover hover:scale-105 transition duration-700">

        <!-- Price Badge -->
        <div class="absolute top-6 right-6 bg-green-600 text-white px-6 py-3 rounded-2xl shadow-lg text-xl font-bold">
          ₹ <%= home.price %>
        </div>
      </div>

      <!-- Content Section -->
      <div class="p-10 grid md:grid-cols-3 gap-10">

        <!-- Left Content -->
        <div class="md:col-span-2">

          <h1 class="text-4xl font-bold text-gray-800 mb-4">
            <%= home.homeName %>
          </h1>

          <p class="text-gray-500 mb-6 text-lg">
            📍 <%= home.address %>
          </p>

          <!-- Property Stats -->
          <div class="grid grid-cols-3 gap-6 mb-8">

            <div class="bg-gray-50 p-5 rounded-2xl shadow text-center">
              <p class="text-gray-400 text-sm">Rooms</p>
              <p class="text-2xl font-semibold text-gray-800">
                <%= home.rooms %>
              </p>
            </div>

            <div class="bg-gray-50 p-5 rounded-2xl shadow text-center">
              <p class="text-gray-400 text-sm">Type</p>
              <p class="text-2xl font-semibold text-gray-800">
                Apartment
              </p>
            </div>

            <div class="bg-gray-50 p-5 rounded-2xl shadow text-center">
              <p class="text-gray-400 text-sm">Status</p>
              <p class="text-2xl font-semibold text-green-600">
                Available
              </p>
            </div>

          </div>

          <!-- Description -->
          <div>
            <h2 class="text-2xl font-semibold mb-3">Description</h2>
            <p class="text-gray-600 leading-relaxed">
              This beautiful property offers spacious rooms, modern interiors,
              and a prime location. Perfect for families looking for comfort and
              convenience. Natural lighting and well-ventilated rooms make this
              home an ideal choice.
            </p>
          </div>

        </div>

        <!-- Right Sidebar -->
        <div class="bg-gray-50 p-8 rounded-2xl shadow-lg">
          <div class="mt-8 text-gray-500 text-sm p-8">
            Listed on: <%= new Date().toDateString() %>
          </div>
          
          <form action="/favourites" method="POST">
            <input type="hidden" name="homeId" value="<%= home.id %>">
            <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-2xl font-semibold hover:bg-green-700 transition duration-300">
              Add to Favorites
            </button>
          </form>
        </div>

      </div>

    </div>

  </div>

</body>
</html>